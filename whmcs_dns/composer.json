{
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/moddengine/plexdns"
        }
    ],
    "require": {
        "namingo/plexdns": "dev-fix/bunny-zone-record-ids"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "php tests/security.php"
    }
}
